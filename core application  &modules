// 4. TRUSTED CONTACTS MODULE
// ==========================================
const ContactsModule = {
    init() {
        if (!currentUser) return;
        const q = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'trustedContacts');
        onSnapshot(q, (snapshot) => {
            const list = document.getElementById('contacts-grid');
            if (!list) return;
            list.innerHTML = '';
            if (snapshot.empty) {
                list.innerHTML = `<div class="glass-panel p-6 rounded-2xl text-center col-span-2 text-gray-400 text-xs">No trusted contacts added yet. Add at least 2 emergency contacts.</div>`;
                document.getElementById('dash-contacts-count').innerText = '0 Active';
                return;
            }
            document.getElementById('dash-contacts-count').innerText = `${snapshot.size} Active`;
            snapshot.forEach(docSnap => {
                const c = docSnap.data();
                const card = document.createElement('div');
                card.className = "glass-panel p-4 rounded-2xl flex items-center justify-between";
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center font-bold text-sm">
                            ${c.name.charAt(0)}
                        </div>
                        <div>
                            <h5 class="font-bold text-sm">${c.name} ${c.isPrimary ? '<span class="text-[10px] bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full ml-1 font-semibold">Primary</span>' : ''}</h5>
                            <p class="text-xs text-gray-500">${c.phone} • ${c.relation}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <a href="tel:${c.phone}" class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-xl transition"><i class="fa-solid fa-phone"></i></a>
                        <button onclick="window.ContactsModule.deleteContact('${docSnap.id}')" class="p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
                list.appendChild(card);
            });
        }, (error) => {
            console.error(error);
        });
    },

    openAddModal() {
        document.getElementById('modal-contact-name').value = '';
        document.getElementById('modal-contact-phone').value = '';
        document.getElementById('modal-contact-relation').value = '';
        document.getElementById('modal-contact-primary').checked = false;
        document.getElementById('contact-modal').classList.remove('hidden');
    },

    closeModal() {
        document.getElementById('contact-modal').classList.add('hidden');
    },

    async saveContact() {
        const name = document.getElementById('modal-contact-name').value.trim();
        const phone = document.getElementById('modal-contact-phone').value.trim();
        const relation = document.getElementById('modal-contact-relation').value.trim();
        const isPrimary = document.getElementById('modal-contact-primary').checked;

        if (!name || !phone) {
            showToast('Please enter name and phone number', 'error');
            return;
        }

        try {
            await addDoc(collection(db, 'artifacts', appId, 'users', currentUser.uid, 'trustedContacts'), {
                name, phone, relation, isPrimary, createdAt: serverTimestamp()
            });
            showToast('Trusted contact added successfully', 'success');
            this.closeModal();
            TimelineModule.logEvent('Trusted Contact Added', name);
        } catch (err) {
            showToast(err.message, 'error');
        }
    },

    async deleteContact(id) {
        if (!confirm('Are you sure you want to remove this trusted contact?')) return;
        try {
            await deleteDoc(doc(db, 'artifacts', appId, 'users', currentUser.uid, 'trustedContacts', id));
            showToast('Contact removed', 'info');
        } catch (err) {
            showToast(err.message, 'error');
        }
    }
};
window.ContactsModule = ContactsModule;

