// 1. AUTHENTICATION MODULE
// ==========================================
const AuthModule = {
    init() {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            signInWithCustomToken(auth, __initial_auth_token).catch(() => signInAnonymously(auth));
        } else {
            signInAnonymously(auth);
        }

        onAuthStateChanged(auth, async (user) => {
            currentUser = user;
            if (user) {
                document.getElementById('auth-view').classList.add('hidden');
                document.getElementById('main-app').classList.remove('hidden');
                const phone = user.phoneNumber || '+91 98765 43210';
                const name = user.displayName || 'Safety Guardian';
                document.getElementById('sidebar-user-name').innerText = name;
                document.getElementById('sidebar-user-phone').innerText = phone;
                document.getElementById('sidebar-user-avatar').innerText = name.charAt(0).toUpperCase();
                document.getElementById('mobile-user-initial').innerText = name.charAt(0).toUpperCase();
                
                // Sync user profile in Firestore
                await setDoc(doc(db, 'artifacts', appId, 'users', user.uid), {
                    uid: user.uid,
                    phone: phone,
                    displayName: name,
                    lastActive: serverTimestamp()
                }, { merge: true });

                // Initialize all app modules
                ContactsModule.init();
                TimelineModule.init();
                MapModule.init();
                VoiceAIModule.init();
            } else {
                document.getElementById('auth-view').classList.remove('hidden');
                document.getElementById('main-app').classList.add('hidden');
            }
        });
    },

    sendOTP() {
        const phone = document.getElementById('phone-input').value.trim();
        const code = document.getElementById('country-code').value;
        if (!phone || phone.length < 10) {
            showToast('Please enter a valid mobile number', 'error');
            return;
        }
        const fullPhone = code + phone;
        document.getElementById('sent-phone-display').innerText = fullPhone;
        document.getElementById('auth-phone-step').classList.add('hidden');
        document.getElementById('auth-otp-step').classList.remove('hidden');
        showToast('OTP sent successfully (Sandbox: enter any 6 digits)', 'success');
    },

    verifyOTP() {
        const otp = document.getElementById('otp-input').value.trim();
        if (otp.length !== 6) {
            showToast('Please enter a valid 6-digit OTP', 'error');
            return;
        }
        // In sandbox mode or production sign in
        signInAnonymously(auth).then(() => {
            showToast('Authentication successful!', 'success');
        });
    },

    bypassDemoLogin() {
        signInAnonymously(auth).then(() => {
            showToast('Logged in via Demo Sandbox', 'success');
        }).catch((err) => showToast(err.message, 'error'));
    },

    backToPhoneStep() {
        document.getElementById('auth-otp-step').classList.add('hidden');
        document.getElementById('auth-phone-step').classList.remove('hidden');
    },

    logout() {
        signOut(auth).then(() => {
            showToast('Logged out successfully', 'info');
        });
    }
};
window.AuthModule = AuthModule;

