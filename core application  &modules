// 3. MAP MODULE
// ==========================================
const MapModule = {
    init() {
        if (mapInstance) return;
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition((pos) => {
                currentGPS = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                this.renderMap(currentGPS.lat, currentGPS.lng);
            }, () => {
                this.renderMap(currentGPS.lat, currentGPS.lng);
            });
        } else {
            this.renderMap(currentGPS.lat, currentGPS.lng);
        }
    },

    renderMap(lat, lng) {
        const container = document.getElementById('leaflet-map');
        if (!container) return;
        mapInstance = L.map(container).setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap Safety Bubble'
        }).addTo(mapInstance);

        // User Marker
        L.marker([lat, lng]).addTo(mapInstance).bindPopup('<b>You are here (Secure Bubble)</b>').openPopup();

        // Add dummy safe zones / police stations nearby
        const places = [
            { lat: lat + 0.005, lng: lng + 0.004, title: 'Central Police Station', type: 'police' },
            { lat: lat - 0.006, lng: lng + 0.003, title: 'City General Hospital', type: 'hospital' },
            { lat: lat + 0.003, lng: lng - 0.005, title: 'Women Help Center', type: 'volunteer' }
        ];

        places.forEach(p => {
            L.marker([p.lat, p.lng]).addTo(mapInstance).bindPopup(`<b>${p.title}</b><br>Status: Verified Safe Zone`);
        });
    },

    filterMap(type) {
        showToast(`Filtered map by: ${type}`, 'info');
    }
};
window.MapModule = MapModule;

