// 5. SOS SYSTEM MODULE
// ==========================================
const SOSModule = {
    timerInterval: null,

    async triggerSOS() {
        showToast('EMERGENCY SOS ACTIVATED! Broadcasting Live GPS...', 'error');
        document.getElementById('active-sos-panel').classList.remove('hidden');
        
        // Start countdown timer
        let seconds = 0;
        clearInterval(this.timerInterval);
        this.timerInterval = setInterval(() => {
            seconds++;
            const m = String(Math.floor(seconds / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            const disp = document.getElementById('sos-timer-display');
            if (disp) disp.innerText = `${m}:${s}`;
        }, 1000);

        if (currentUser) {
            try {
                await addDoc(collection(db, 'artifacts', appId, 'users', currentUser.uid, 'sosHistory'), {
                    timestamp: serverTimestamp(),
                    location: currentGPS,
                    status: 'Active'
                });
                TimelineModule.logEvent('SOS Triggered', 'Emergency broadcast active');
            } catch (err) {
                console.error(err);
            }
        }
    },

    cancelSOS() {
        clearInterval(this.timerInterval);
        document.getElementById('active-sos-panel').classList.add('hidden');
        showToast('SOS Cancelled / False alarm dismissed', 'success');
        TimelineModule.logEvent('SOS Cancelled', 'False alarm resolved');
    }
};
window.SOSModule = SOSModule;

