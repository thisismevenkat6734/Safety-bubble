// 7. TIMELINE MODULE
// ==========================================
const TimelineModule = {
    init() {
        if (!currentUser) return;
        const q = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'timeline');
        onSnapshot(q, (snapshot) => {
            const list = document.getElementById('timeline-list');
            const dashRecent = document.getElementById('dash-recent-timeline');
            if (!list) return;
            list.innerHTML = '';
            if (snapshot.empty) {
                list.innerHTML = `<p class="text-xs text-gray-400 text-center py-4">No security events logged yet.</p>`;
                return;
            }
            let html = '';
            snapshot.forEach(docSnap => {
                const e = docSnap.data();
                html += `
                    <div class="p-3.5 rounded-2xl bg-white/50 dark:bg-gray-800/40 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center font-bold"><i class="fa-solid fa-shield-halved"></i></div>
                            <div>
                                <h5 class="font-bold">${e.action}</h5>
                                <p class="text-[10px] text-gray-400">${e.details}</p>
                            </div>
                        </div>
                        <span class="text-[10px] text-gray-400">Just now</span>
                    </div>
                `;
            });
            list.innerHTML = html;
            if (dashRecent) dashRecent.innerHTML = html;
        });
    },

    async logEvent(action, details) {
        if (!currentUser) return;
        try {
            await addDoc(collection(db, 'artifacts', appId, 'users', currentUser.uid, 'timeline'), {
                action, details, timestamp: serverTimestamp()
            });
        } catch (err) {
            console.error(err);
        }
    },

    exportPDF() {
        showToast('Generating official PDF audit report...', 'success');
        setTimeout(() => showToast('PDF Report downloaded successfully', 'success'), 1500);
    }
};
window.TimelineModule = TimelineModule;

